<Window x:Class="View.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Библиотека игр" Height="650" Width="1000" MinHeight="600" MinWidth="900"
        Background="#F0F0F0">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Таблица (слева) -->
            <ColumnDefinition Width="350"/>
            <!-- Панель (справа) -->
        </Grid.ColumnDefinitions>

        <!-- === ТАБЛИЦА ИГР === -->
        <DataGrid Grid.Column="0" Margin="0,0,10,0"
                  ItemsSource="{Binding Games}"
                  SelectedItem="{Binding SelectedGame}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="DarkGray" 
                  BorderBrush="Gray" 
                  BorderThickness="1" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Разработчик" Binding="{Binding Developer}" Width="*"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding GameGenre}" Width="90"/>
                <DataGridTextColumn Header="Платформа" Binding="{Binding PlatformName}" Width="90"/>
                <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" Width="50"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- === ПАНЕЛЬ УПРАВЛЕНИЯ === -->
        <StackPanel Grid.Column="1">

            <!-- Поля ввода -->
            <GroupBox Header="Информация об игре" Padding="5" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название"/>
                        <TextBox Grid.Column="1" Text="{Binding InputTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Разработчик"/>
                        <TextBox Grid.Column="1" Text="{Binding InputDeveloper, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Жанр"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AllGenres}" SelectedItem="{Binding SelectedInputGenre}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Платформа"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Platforms}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedInputPlatformId}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Год выхода"/>
                        <TextBox Grid.Column="1" Text="{Binding InputReleaseYear, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Рейтинг"/>
                        <TextBox Grid.Column="1" Text="{Binding InputRating, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Кнопки управления -->
            <GroupBox Header="Управление списком" Padding="5">
                <StackPanel>
                    <!-- CRUD -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Добавить" Command="{Binding AddGameCommand}" Margin="2" Height="25"/>
                        <Button Grid.Column="1" Content="Изменить" Command="{Binding UpdateGameCommand}" Margin="2" Height="25"/>
                        <Button Grid.Column="2" Content="Удалить" Command="{Binding DeleteGameCommand}" Margin="2" Height="25"/>
                    </Grid>

                    <!-- Дополнительные функции (Скриншот) -->
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Фильтровать" Command="{Binding FilterByPlatformCommand}" Margin="2" FontSize="10"/>
                        <Button Grid.Column="1" Content="Группировать" Command="{Binding GroupByGenreCommand}" Margin="2" FontSize="10"/>
                        <Button Grid.Column="2" Content="Обновить" Command="{Binding RefreshCommand}" Margin="2" FontSize="10"/>
                        <Button Grid.Column="3" Content="Сбросить" Command="{Binding ClearInputsCommand}" Margin="2" FontSize="10"/>
                    </Grid>

                    <Separator Margin="0,10"/>

                    <!-- Поиск -->
                    <TextBlock Text="Поиск (введите название платформы):" FontSize="10" Foreground="Gray"/>
                    <TextBox Text="{Binding PlatformSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    <Button Content="Найти по названию платформы" Command="{Binding SearchPlatformCommand}" Margin="0,5"/>

                    <Separator Margin="0,10"/>

                    <!-- Добавление платформы -->
                    <TextBlock Text="Новая платформа:" FontSize="11"/>
                    <TextBox Text="{Binding NewPlatformName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                    <Button Content="Добавить платформу" Command="{Binding AddPlatformCommand}" Margin="0,5"/>

                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>
